{
  "name": "ng-ai",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ai/ng/src",
  "prefix": "ai",
  "projectType": "library",
  "tags": [
    "scope:ai",
    "type:lib",
    "framework:ng",
    "type:brick"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "packages/ai/ng/ng-package.json",
        "tsConfig": "packages/ai/ng/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ai/ng/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
