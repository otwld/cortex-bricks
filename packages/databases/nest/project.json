{
  "name": "nest-mongoose",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/databases/nest/src",
  "projectType": "library",
  "tags": [
    "scope:database",
    "type:lib",
    "framework:nest",
    "type:brick"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/databases/nest",
        "tsConfig": "packages/databases/nest/tsconfig.lib.json",
        "packageJson": "packages/databases/nest/package.json",
        "main": "packages/databases/nest/src/index.ts",
        "format": [
          "esm"
        ],
        "assets": [
          "packages/databases/nest/*.md"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
