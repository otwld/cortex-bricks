{
  "name": "ts-websocket",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/websocket/ts/src",
  "projectType": "library",
  "tags": [
    "scope:websocket",
    "type:types",
    "type:brick"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/websocket/ts",
        "main": "packages/websocket/ts/src/index.ts",
        "tsConfig": "packages/websocket/ts/tsconfig.lib.json",
        "format": [
          "esm"
        ],
        "assets": [
          "packages/websocket/ts/*.md"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsd packages/websocket/ts"
      }
    }
  }
}
