{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@otwld/ts-ai": ["./packages/ai/ts/src/index.ts"],
      "@otwld/nest-ai": ["./packages/ai/nest/src/index.ts"],
      "@otwld/ng-ai": ["./packages/ai/ng/src/index.ts"],

      "@otwld/ts-auth": ["./packages/auth/ts/src/index.ts"],
      "@otwld/nest-auth": ["./packages/auth/nest/src/index.ts"],
      "@otwld/ng-auth": ["./packages/auth/ng/src/index.ts"],
      "@otwld/ng-auth/core": ["./packages/auth/ng/core/src/index.ts"],

      "@otwld/ng-dashboard/core": ["./packages/dashboard/ng/core/src/index.ts"],
      "@otwld/ng-dashboard/layout": ["./packages/dashboard/ng/src/lib/layout/index.ts"],
      "@otwld/ng-dashboard/pages": ["./packages/dashboard/ng/src/lib/pages/index.ts"],
      "@otwld/ng-dashboard/routes": ["./packages/dashboard/ng/src/lib/dashboard.routes.ts"],

      "@otwld/ng-ui": ["./packages/ui/ng/src/index.ts"],
      "@otwld/ng-tanstack": ["./packages/tanstack/ng/src/index.ts"],

      "@otwld/ts-feature-flags": ["./packages/feature-flags/ts/src/index.ts"],
      "@otwld/ng-feature-flags": ["./packages/feature-flags/ng/src/index.ts"],
      "@otwld/nest-feature-flags": ["./packages/feature-flags/nest/src/index.ts"],

      "@otwld/nest-mongoose": ["./packages/databases/nest/src/index.ts"],

      "@otwld/nest-mail": ["./packages/mail/nest/src/index.ts"],

      "@otwld/nest-sdk": ["./packages/sdk/nest/src/index.ts"],
      "@otwld/ts-sdk": ["./packages/sdk/ts/src/index.ts"],
      "@otwld/ng-cdk": ["./packages/sdk/ng/src/index.ts"],
      "@otwld/ng-cdk/forms": ["./packages/sdk/ng/forms/src/index.ts"],
      "@otwld/ng-cdk/testing": ["./packages/sdk/ng/testing/src/index.ts"],

      "@otwld/ts-storage": ["./packages/storage/ts/src/index.ts"],
      "@otwld/nest-storage": ["./packages/storage/nest/src/index.ts"],
      "@otwld/ng-storage": ["./packages/storage/ng/src/index.ts"],

      "@otwld/ts-storybook": ["./packages/storybook/ts/src/index.ts"],
      "@otwld/ts-storybook/vite": ["./packages/storybook/ts/src/vite/index.ts"],
      "@otwld/ng-storybook": ["./packages/storybook/ng/src/index.ts"],

      "@otwld/ts-users": ["./packages/users/ts/src/index.ts"],
      "@otwld/nest-users": ["./packages/users/nest/src/index.ts"],
      "@otwld/ng-users": ["./packages/users/ng/src/index.ts"],
      "@otwld/ng-users/core": ["./packages/users/ng/core/src/index.ts"],

      "@otwld/ts-websocket": ["./packages/websocket/ts/src/index.ts"],
      "@otwld/nest-websocket": ["./packages/websocket/nest/src/index.ts"],
      "@otwld/ng-websocket": ["./packages/websocket/ng/src/index.ts"],

      "@otwld/ts-chat": ["./packages/chat/ts/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
