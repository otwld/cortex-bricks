# Backend environment template.
#
# Copy this file to apps/backend/.env.local for local development:
#   cp apps/backend/.env.example apps/backend/.env.local
#
# Keep real secrets out of Git. Replace every "replace-with-..." value before running production,
# staging, or any shared environment.
#
# Optional secrets are commented out on purpose. Setting an optional secret to an empty value can
# fail validation because the backend validates env vars with Zod.


# -------------------------------------------------------------------------------------------------
# Runtime
# -------------------------------------------------------------------------------------------------

# Optional. Defaults to 3000 when omitted. Used by the Nest HTTP and Socket.IO servers.
PORT=3000

# Optional. Used by auth cookie security, dev-login safeguards, and development webpack output.
NODE_ENV=development

# Optional. Set to true only for websocket demo smoke tests; regular backend config is skipped.
WS_DEMO_ONLY=false

# -------------------------------------------------------------------------------------------------
# Application
# -------------------------------------------------------------------------------------------------

# Required. Public frontend origin used for CORS and auth email links.
FRONTEND_URL=http://localhost:4200

# Optional. Comma-separated emails that receive application-level admin permissions.
# ADMIN_EMAILS=admin@example.com,ops@example.com


# -------------------------------------------------------------------------------------------------
# Database
# -------------------------------------------------------------------------------------------------

# Required. MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/backend


# -------------------------------------------------------------------------------------------------
# Authentication
# -------------------------------------------------------------------------------------------------

# Required. Generate separate values per environment:
#   openssl rand -base64 32
JWT_SECRET=replace-with-generated-jwt-secret
JWT_REFRESH_SECRET=replace-with-generated-refresh-secret


# -------------------------------------------------------------------------------------------------
# OAuth Providers
# -------------------------------------------------------------------------------------------------

# Required. Google OAuth app credentials and backend callback URL.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Required. GitHub OAuth app credentials and backend callback URL.
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback


# -------------------------------------------------------------------------------------------------
# Mail
# -------------------------------------------------------------------------------------------------

# Optional. Defaults to postal. Supported values: postal, smtp, preview.
MAIL_TRANSPORT=postal
MAIL_FROM=noreply@example.com

# Required when MAIL_TRANSPORT=postal. Postal server used by account verification and
# password reset email.
POSTAL_SERVER_URL=http://postal.localhost
POSTAL_API_KEY=replace-with-postal-api-key

# Required when MAIL_TRANSPORT=smtp. Set SMTP_USER and SMTP_PASSWORD together when auth is needed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-with-smtp-user
# SMTP_PASSWORD=replace-with-smtp-password

# Required when MAIL_TRANSPORT=preview. Helm dev installs usually use stack-mailpit.
# MAILPIT_HOST=localhost
# MAILPIT_SMTP_PORT=1025


# -------------------------------------------------------------------------------------------------
# Object Storage
# -------------------------------------------------------------------------------------------------

# Required. MinIO or another S3-compatible endpoint.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=monorepo-starter-backend
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# Optional. Defaults to false when omitted.
MINIO_USE_SSL=false


# -------------------------------------------------------------------------------------------------
# AI
# -------------------------------------------------------------------------------------------------

# Optional. Leave commented out when OpenAI-backed AI features are not configured.
# OPENAI_API_KEY=sk-replace-with-openai-api-key

# Optional. Model aliases default to these values when omitted.
AI_CHAT_MODEL=gpt-5.4
AI_FAST_MODEL=gpt-5.4-mini
AI_STRUCTURED_MODEL=gpt-5.4


# -------------------------------------------------------------------------------------------------
# Development Auth
# -------------------------------------------------------------------------------------------------

# Optional. Defaults to false when omitted. Dev login is ignored in production.
DEV_AUTH_ENABLED=false

# Required only when DEV_AUTH_ENABLED=true.
# DEV_AUTH_EMAIL=developer@example.com
# DEV_AUTH_PASSWORD=replace-with-local-dev-password
