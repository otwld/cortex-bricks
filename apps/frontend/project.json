{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/frontend/src",
  "tags": [
    "scope:frontend",
    "type:app",
    "framework:ng",
    "type:brick"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "syncGenerators": [
        "@juristr/nx-tailwind-sync:source-directives"
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/frontend",
        "browser": "apps/frontend/src/main.ts",
        "tsConfig": "apps/frontend/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/frontend/public"
          }
        ],
        "styles": [
          "apps/frontend/src/styles.css"
        ],
        "stylePreprocessorOptions": {
          "includePaths": [
            "apps/frontend/src/styles"
          ]
        },
        "server": "apps/frontend/src/main.server.ts",
        "ssr": {
          "entry": "apps/frontend/src/server.ts"
        },
        "outputMode": "server"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/frontend/src/app/ws-demo/ws-demo.routes.ts",
              "with": "apps/frontend/src/app/ws-demo/ws-demo.routes.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "30kb"
            }
          ],
          "outputHashing": "all"
        },
        "stats": {
          "outputHashing": "all",
          "statsJson": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "syncGenerators": [
        "@juristr/nx-tailwind-sync:source-directives"
      ],
      "configurations": {
        "production": {
          "buildTarget": "frontend:build:production",
          "proxyConfig": "apps/frontend/proxy.conf.json"
        },
        "development": {
          "buildTarget": "frontend:build:development",
          "poll": 1000,
          "proxyConfig": "apps/frontend/proxy.conf.json"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "frontend:build",
        "port": 4200,
        "staticFilePath": "dist/apps/frontend/browser",
        "spa": true
      }
    },
    "docker:build": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/apps/frontend/Dockerfile",
        "{workspaceRoot}/.dockerignore"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --file apps/frontend/Dockerfile --tag apps-frontend --tag ${DOCKER_REGISTRY:-harbor.otwld.com}/${DOCKER_NAMESPACE:-otwld/monorepo-starter}/${FRONTEND_IMAGE_NAME:-frontend}:${IMAGE_TAG:-latest} ."
      }
    },
    "docker:push": {
      "dependsOn": [
        "docker:build"
      ],
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "docker push ${DOCKER_REGISTRY:-harbor.otwld.com}/${DOCKER_NAMESPACE:-otwld/monorepo-starter}/${FRONTEND_IMAGE_NAME:-frontend}:${IMAGE_TAG:-latest}"
      }
    }
  }
}
