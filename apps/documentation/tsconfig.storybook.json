{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "exclude": ["**/*.spec.ts", "**/*.test.ts"],
  "include": [
    "**/*.mdx",
    "src/**/*.stories.ts",
    "src/**/*.stories.js",
    "src/**/*.stories.jsx",
    "src/**/*.stories.tsx",
    "src/**/*.stories.mdx",
    "src/*.js",
    "src/*.ts",
    "../../packages/**/*.stories.ts",
    "../../packages/**/*.stories.js",
    "../../packages/**/*.stories.jsx",
    "../../packages/**/*.stories.tsx",
    "../../packages/**/*.stories.mdx"
  ]
}
